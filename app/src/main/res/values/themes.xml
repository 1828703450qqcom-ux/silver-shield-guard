<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 淡蓝色主题 -->
    <style name="Theme.YinDunShouHu" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 主色调 - 淡蓝色 -->
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary_variant</item>

        <!-- 状态栏颜色 - 淡蓝色 -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>

        <!-- 窗口背景 - 淡蓝色调 -->
        <item name="android:windowBackground">@color/background_light</item>

        <!-- 文字颜色 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- 按钮颜色 -->
        <item name="android:colorButtonNormal">@color/primary</item>

        <!-- 选中状态颜色 -->
        <item name="android:colorActivatedHighlight">@color/light_blue_100</item>
        <item name="android:colorFocusedHighlight">@color/light_blue_200</item>
        <item name="android:colorPressedHighlight">@color/light_blue_100</item>
    </style>

    <!-- 适老化大字体主题 -->
    <style name="Theme.YinDunShouHu.ElderMode" parent="Theme.YinDunShouHu">
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- 深色模式主题 -->
    <style name="Theme.YinDunShouHu.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/light_blue_300</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/light_blue_400</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">#E8EAF6</item>
        <item name="android:textColorSecondary">#B0BEC5</item>
    </style>
</resources>
